APP_NAME=GEVES
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_USE_DEV_SERVER=false

# Documents de travail DOCX/XLSX des taches : ONLYOFFICE DocSpace.
# Utiliser une salle personnalisee dediee. Eviter tout lien d'edition public sur la salle entiere.
# DOCSPACE_FILE_LINKS_ENABLED reste a false tant que les liens d'edition par fichier
# ne sont pas autorises : sans eux, aucun document de tache ne peut etre cree.
DOCSPACE_URL=
DOCSPACE_API_KEY=
DOCSPACE_ROOM_ID=
DOCSPACE_FILE_LINKS_ENABLED=false
LIVRET_PDF_NODE_BINARY=node

# Cloudflare Turnstile : inscription et contact public (cles du widget liees au domaine)
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Paiement en ligne (laisser vide = passerelle inactive, repli sur « manual »)
PAYMENT_GATEWAY=manual


# FedaPay
FEDAPAY_SECRET=
FEDAPAY_MODE=test
# Proposer la carte bancaire (le compte marchand doit l'accepter).
FEDAPAY_CARD=true
# Cle PUBLIQUE (pk_...) : active le formulaire embarque. Vide = redirection.
FEDAPAY_PUBLIC_KEY=
FEDAPAY_WEBHOOK_SECRET=

# Certification des attestations (identite verifiable, Ed25519 / VC-JWT)
# Graine privee de l'emetteur (base64url, 32 octets) - generer avec
# `php artisan attestations:keygen`. Vide = attestations non signees.
ATTESTATION_SIGNING_KEY=
ATTESTATION_KID=key-ed25519-1
# Cles publiques retirees (rotation), JSON {"kid":"base64url",...}
ATTESTATION_RETIRED_KEYS=

# Fournisseurs d'IA (cle + modele par defaut)
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROK_API_KEY=
GROK_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
