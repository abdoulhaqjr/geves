# =============================================================================
#  GEVES - modèle d'environnement de PRODUCTION (o2switch / cPanel)
#
#  Copier en `.env` SUR LE SERVEUR, puis remplir. Ne jamais committer le `.env`
#  rempli : `.gitignore` couvre déjà `.env` et `.env.production`.
#  Mode d'emploi complet : DEPLOIEMENT.md
# =============================================================================

APP_NAME=GEVES
APP_ENV=production
APP_KEY=
# ⚠️ APP_DEBUG=true en production affiche la trace ET les variables
# d'environnement (donc les clés) sur la page d'erreur. Jamais true ici.
APP_DEBUG=false
# ⚠️ Sans protocole ni barre finale. APP_URL sert à fabriquer les liens des
# e-mails, le disque `public`, les QR codes ET l'adresse inscrite DANS les
# attestations signées (voir DEPLOIEMENT.md, étape « attestations »).
APP_URL=https://geves.univkara.tg

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
# ⚠️ Pas de clé de fuseau ici : `config/app.php` fixe « UTC » EN DUR, une
# `APP_TIMEZONE` dans ce fichier ne serait pas lue. UTC correspond à l'heure du
# Togo (GMT+0) ; un colloque au Bénin (GMT+1) s'afficherait avec une heure de
# retard, et c'est alors le fichier de configuration qu'il faut changer, pas
# l'environnement.

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` remplirait le disque mutualisé en quelques jours.
LOG_LEVEL=warning

# ---- Base de données (cPanel > Bases de données MySQL) ----------------------
# Les noms créés par cPanel sont préfixés par le compte : `moncompte_geves`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---- Sessions, cache, file d'attente ---------------------------------------
# Tout en base : pas de Redis sur un mutualisé, et le disque est partagé.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.univkara.tg
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ⚠️ Les e-mails sont des jobs (ShouldQueue). Sans travailleur, RIEN ne part.
# Le cron de DEPLOIEMENT.md lance `queue:work --stop-when-empty` chaque minute.
QUEUE_CONNECTION=database

# ---- E-mail ----------------------------------------------------------------
# Boîte créée dans cPanel > Comptes de messagerie. Port 465 = SSL implicite.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ---- Super-administrateur --------------------------------------------------
# ⚠️ Lus UNE SEULE FOIS, à la création du compte par `db:seed`. En production,
# un ADMIN_PASSWORD vide fait ÉCHOUER le seeder au lieu de poser « password ».
# Les relances ultérieures ne retouchent jamais un mot de passe déjà changé.
ADMIN_NAME="Administrateur"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Paiement en ligne -----------------------------------------------------
# `manual` = encaissement hors ligne, aucune passerelle appelée.
PAYMENT_GATEWAY=manual


FEDAPAY_SECRET=
FEDAPAY_MODE=live
# Proposer la carte bancaire (le compte marchand doit l'accepter).
FEDAPAY_CARD=true
FEDAPAY_WEBHOOK_SECRET=

# ---- Attestations certifiées (Ed25519) -------------------------------------
# Générer SUR LE SERVEUR : `php artisan attestations:keygen`.
# ⚠️ Perdre cette graine rend invérifiables toutes les attestations signées.
ATTESTATION_SIGNING_KEY=
ATTESTATION_KID=key-ed25519-1
ATTESTATION_RETIRED_KEYS=

# ---- Assistants IA ---------------------------------------------------------
# Laisser vide désactive l'assistant : la plateforme fonctionne sans.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROK_API_KEY=
GROK_MODEL=

# ---- Production de vidéos de prise en main ---------------------------------
# ⚠️ INDISPONIBLE sur un mutualisé : le rendu réclame FFmpeg et un processus
# long, que l'hébergement n'offre pas. Les guides TEXTE fonctionnent ; seule la
# fabrication des vidéos est hors de portée. Ne pas la lancer depuis le
# back-office en production.
