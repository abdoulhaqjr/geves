includes:
    - vendor/larastan/larastan/extension.neon
    # Résidu figé : essentiellement des faux positifs Larastan « nullsafe.neverNull »
    # sur les relations BelongsTo (typées non-nulles par l'extension, alors que
    # l'accès reste nullable au runtime → le `?->` est nécessaire). Les vrais bugs
    # de type (Model générique) ont été corrigés en annotant les modèles.
    - phpstan-baseline.neon

parameters:
    level: 5

    paths:
        - app

    # ⚠️ FPDI/FPDF ne se découvrent pas tout seuls : `setasign/fpdf` publie un
    # `\FPDF` SANS namespace par classmap, et l'analyse ne résout alors ni lui ni
    # ses descendants (`setasign\Fpdi\Fpdi`) - neuf « classe inconnue » dans
    # `GenerateBadgeExport`, pour une dépendance pourtant installée.
    scanDirectories:
        - vendor/setasign

    ignoreErrors:
        # Propriétés magiques des composants Livewire (bindings de vue).
        # reportUnmatched:false - le motif reste valable pour le futur code
        # Livewire même quand aucune occurrence n'existe à un instant donné.
        -
            identifier: property.notFound
            paths:
                - app/Livewire/*
            reportUnmatched: false
